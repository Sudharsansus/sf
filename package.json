{
  "name": "sus",
  "version": "7.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:make-admin": "npm run make-admin -w @isaii/db"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@isaii/config": "*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
