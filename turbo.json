{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ELEVENLABS_*",
        "DATABASE_URL*",
        "REDIS_URL",
        "REDIS_TOKEN",
        "NEXTAUTH_*",
        "GOOGLE_CLIENT_*",
        "NEXT_PUBLIC_*",
        "R2_*",
        "YOUTUBE_CLIENT_*",
        "INSTAGRAM_APP_*",
        "INNGEST_*",
        "CLAUDE_MODEL",
        "DODO_*",
        "RAZORPAY_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
