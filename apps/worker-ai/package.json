{
  "name": "@isaii/worker-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Inngest host for the AI pipeline (no serverless time limits).",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "inngest": "4.25.0",
    "tsx": "4.23.15",
    "@isaii/domain-episodes": "*",
    "@isaii/queue": "*",
    "@isaii/logger": "*",
    "@isaii/env": "*",
    "@isaii/ai-gateway": "*",
    "@isaii/db": "*"
  },
  "devDependencies": {
    "@isaii/config": "*",
    "@types/node": "22.20.5"
  }
}
