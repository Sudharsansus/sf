{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "apps/web": { "entry": ["app/**/{page,layout,route,error,not-found}.{ts,tsx}", "proxy.ts", "scripts/*.ts"], "project": ["**/*.{ts,tsx}"] },
    "packages/*": { "entry": ["src/index.ts", "scripts/*.ts"], "project": ["src/**/*.ts", "tests/**/*.ts"] }
  }
}
