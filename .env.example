# Copy to apps/web/.env.local for local dev. In production these live in Vercel.

# Core
# Production: https://isaii.si for both URLs below
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data
DATABASE_URL=
REDIS_URL=
REDIS_TOKEN=

# AI
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Payments
DODO_PAYMENTS_WEBHOOK_SECRET=

# Social publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Background jobs (Inngest) — added automatically by the Vercel integration.
# For local dev run `npx inngest-cli@latest dev` instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
