# Copy to apps/web/.env.local for local dev. In production these live in Vercel.

# Core
# Production: https://isaii.si for both URLs below
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data
DATABASE_URL=
REDIS_URL=
REDIS_TOKEN=

# AI
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Payments - India (INR, UPI): Razorpay. Webhook: /api/webhooks/razorpay, event order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payments - international (USD): Dodo. Webhook: /api/webhooks/dodo, event payment.succeeded
DODO_PAYMENTS_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
# One Dodo product id per catalogue item (apps/web/lib/billing.ts)
DODO_PRODUCT_LITE=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_STUDIO=
DODO_PRODUCT_AGENCY=
DODO_PRODUCT_PACK_30=
DODO_PRODUCT_PACK_60=
DODO_PRODUCT_PACK_120=
DODO_PRODUCT_PACK_300=

# Social publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Background jobs (Inngest) — added automatically by the Vercel integration.
# For local dev run `npx inngest-cli@latest dev` instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
