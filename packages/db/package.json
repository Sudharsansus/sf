{
  "name": "@isaii/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "make-admin": "tsx --env-file=../../.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@isaii/core": "*",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@isaii/config": "*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
